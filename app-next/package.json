{
  "name": "@feedpon/app-next",
  "type": "module",
  "scripts": {
    "build": "pnpm run --aggregate-output --parallel '/^build:/'",
    "build:bundle": "bun bundle.ts",
    "build:typecheck": "tsc --build",
    "watch": "pnpm run --parallel '/^watch:/'",
    "watch:bundle": "bun bundle.ts --watch",
    "watch:typecheck": "tsc --build --watch --preserveWatchOutput",
    "clean": "rm --force --recursive dist/css dist/js"
  },
  "dependencies": {
    "@feedpon/feedly-client": "workspace:^",
    "@types/chrome": "^0.2.2",
    "barebind": "catalog:"
  }
}
