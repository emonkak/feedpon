{
  "name": "feedpon-state",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@emonkak/ebit": "catalog:",
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1",
    "openapi-typescript": "^7.6.1",
    "openapi-typescript-helpers": "^0.0.15",
    "wireit": "^0.14.10"
  },
  "sideEffects": false,
  "wireit": {
    "build": {
      "dependencies": [
        "build:feedly",
        "build:hatenaBookmark",
        "build:wedata"
      ]
    },
    "build:feedly": {
      "command": "openapi-typescript openapi/feedly.json -o src/api/feedlyTypes.d.ts",
      "files": [
        "openapi/feedly.json"
      ],
      "output": [
        "src/api/feedlyTypes.d.ts"
      ]
    },
    "build:hatenaBookmark": {
      "command": "openapi-typescript openapi/hatenaBookmark.json -o src/api/hatenaBookmarkTypes.d.ts",
      "files": [
        "openapi/hatenaBookmark.json"
      ],
      "output": [
        "src/api/hatenaBookmarkTypes.d.ts"
      ]
    },
    "build:wedata": {
      "command": "openapi-typescript openapi/wedata.json -o src/api/wedataTypes.d.ts",
      "files": [
        "openapi/wedata.json"
      ],
      "output": [
        "src/api/wedataTypes.d.ts"
      ]
    }
  }
}
