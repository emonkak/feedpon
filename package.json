{
  "type": "module",
  "scripts": {
    "build": "wireit",
    "ci": "pnpm run clean && pnpm run lint && pnpm run build && pnpm run test --coverage",
    "clean": "pnpm run --recursive clean",
    "format": "biome check --fix",
    "lint": "biome ci",
    "test": "vitest run",
    "watch": "wireit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "barebind": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "esbuild-plugin-native-css-module": "^1.4.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wireit": "^0.14.13"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./app:build",
        "./app-next:build"
      ]
    },
    "watch": {
      "dependencies": [
        "./app:watch",
        "./app-next:watch"
      ]
    }
  }
}
