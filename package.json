{
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/emonkak/feedpon.git"
  },
  "scripts": {
    "build": "wireit",
    "ci": "wireit",
    "clean": "wireit",
    "format": "wireit",
    "lint": "wireit",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "wireit": {
    "build": {
      "command": "node --import tsx build.ts",
      "files": [
        "assets/css/*",
        "build.ts",
        "packages/*/src/**/*",
        "packages/*/tsconfig.json",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "dist/css/main.css",
        "dist/js/background.js",
        "dist/js/main.js"
      ],
      "dependencies": [
        "typecheck"
      ]
    },
    "clean": {
      "dependencies": [
        "clean:build",
        "clean:tsc"
      ]
    },
    "clean:build": {
      "command": "rm --force --recursive dist/{css,js}"
    },
    "clean:tsc": {
      "command": "tsc --build --clean"
    },
    "ci": {
      "dependencies": [
        "build",
        "lint"
      ]
    },
    "format": {
      "command": "biome check --fix"
    },
    "lint": {
      "command": "biome ci .",
      "files": [
        "packages/*/src/**/*.ts"
      ]
    },
    "typecheck": {
      "command": "tsc --build --pretty --incremental",
      "clean": "if-file-deleted",
      "files": [
        "packages/*/src/**/*",
        "packages/*/tsconfig.json",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "packages/*/*.tsbuildinfo"
      ]
    }
  }
}
