{
  "type": "module",
  "scripts": {
    "build": "pnpm run --recursive build",
    "ci": "pnpm run clean && pnpm run lint && pnpm run build && pnpm run test --coverage",
    "clean": "pnpm run --recursive clean",
    "format": "biome check --fix",
    "lint": "biome ci",
    "test": "vitest run",
    "watch": "pnpm run --recursive watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "barebind": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "esbuild-plugin-native-css-module": "^1.4.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
