{
  "type": "module",
  "scripts": {
    "build": "wireit",
    "ci": "pnpm run clean && pnpm run lint && pnpm run build && pnpm test --coverage",
    "clean": "rm --force --recursive app/dist",
    "format": "biome check --fix",
    "lint": "biome ci .",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./app:build",
        "typecheck"
      ]
    },
    "typecheck": {
      "command": "tsc --build --pretty --incremental",
      "clean": "if-file-deleted",
      "files": [
        "app/src/**/*",
        "app/tsconfig.json",
        "packages/*/src/**/*",
        "packages/*/tsconfig.json",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "app/*.tsbuildinfo",
        "packages/*/*.tsbuildinfo"
      ]
    }
  }
}
