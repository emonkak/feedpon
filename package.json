{
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/emonkak/feedpon.git"
  },
  "scripts": {
    "build": "wireit",
    "ci": "wireit",
    "clean": "wireit",
    "format": "wireit",
    "lint": "wireit",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wireit": "^0.14.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "wireit": {
    "build": {
      "dependencies": [
        "build:css",
        "build:js",
        "./packages/feedpon-state:build"
      ]
    },
    "build:css": {
      "command": "esbuild --bundle --outfile=dist/index.css assets/css/index.css",
      "files": [
        "assets/css/*"
      ],
      "output": [
        "dist/index.css"
      ]
    },
    "build:js": {
      "command": "node build.mjs",
      "output": [
        "dist/index.js",
        "dist/background.js"
      ],
      "dependencies": [
        "tsc"
      ]
    },
    "clean": {
      "dependencies": [
        "clean:dist",
        "clean:tsc"
      ]
    },
    "clean:dist": {
      "command": "rm --force --recursive dist"
    },
    "clean:tsc": {
      "command": "tsc --build --clean"
    },
    "lint": {
      "command": "biome ci .",
      "files": [
        "packages/*/src/**/*.ts"
      ]
    },
    "ci": {
      "dependencies": [
        "build",
        "lint"
      ]
    },
    "format": {
      "command": "biome check --fix"
    },
    "tsc": {
      "command": "tsc --build --pretty --incremental",
      "clean": "if-file-deleted",
      "files": [
        "packages/*/src/**/*.ts",
        "packages/*/tsconfig.json",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "packages/*/*.tsbuildinfo"
      ]
    }
  }
}
