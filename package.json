{
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/emonkak/feedpon.git"
  },
  "scripts": {
    "build": "wireit",
    "ci": "wireit",
    "clean": "wireit",
    "format": "wireit",
    "lint": "wireit",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.10",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wireit": "^0.14.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "wireit": {
    "build": {
      "command": "node --import tsx build.ts",
      "files": [
        "assets/css/*",
        "build.ts",
        "packages/*/src/**/*",
        "packages/*/tsconfig.json",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "dist/background.js",
        "dist/main.css",
        "dist/main.js"
      ],
      "dependencies": [
        "typecheck"
      ]
    },
    "clean": {
      "dependencies": [
        "clean:dist",
        "clean:tsc"
      ]
    },
    "clean:dist": {
      "command": "rm --force --recursive dist"
    },
    "clean:tsc": {
      "command": "tsc --build --clean"
    },
    "ci": {
      "dependencies": [
        "build",
        "lint"
      ]
    },
    "format": {
      "command": "biome check --fix"
    },
    "lint": {
      "command": "biome ci .",
      "files": [
        "packages/*/src/**/*.ts"
      ]
    },
    "typecheck": {
      "command": "tsc --build --pretty --incremental",
      "clean": "if-file-deleted",
      "files": [
        "packages/*/src/**/*",
        "packages/*/tsconfig.json",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "packages/*/*.tsbuildinfo"
      ]
    }
  }
}
