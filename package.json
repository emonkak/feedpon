{
  "type": "module",
  "scripts": {
    "build": "wireit",
    "ci": "pnpm run clean && pnpm run lint && pnpm run build && pnpm test --coverage",
    "clean": "rm --force --recursive dist",
    "format": "biome check --fix",
    "lint": "biome ci .",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "esbuild-plugin-minify-templates": "github:emonkak/barebind#path:tools/esbuild-plugin-minify-templates",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wireit": "^0.14.13"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:css",
        "build:img",
        "build:js"
      ]
    },
    "build:css": {
      "command": "esbuild --bundle app/css/app.css --outfile=dist/app.css",
      "files": [
        "app/css/**/*"
      ],
      "output": [
        "dist/app.css"
      ],
      "dependencies": [
        "build:pre"
      ]
    },
    "build:js": {
      "command": "bun build.js",
      "files": [
        "build.js"
      ],
      "output": [
        "dist/app.js",
        "dist/background.js"
      ],
      "dependencies": [
        "build:pre",
        "typecheck"
      ]
    },
    "build:img": {
      "command": "install -D --mode=644 --target-directory=dist/img app/img/*",
      "files": [
        "app/img/*"
      ],
      "output": [
        "dist/img/*"
      ],
      "dependencies": [
        "build:pre"
      ]
    },
    "build:pre": {
      "command": "install -D --mode=644 --target-directory=dist app/{app.html,manifest.json}",
      "files": [
        "app/app.html",
        "app/manifest.json"
      ],
      "output": [
        "dist/app.html",
        "dist/manifest.json"
      ]
    },
    "typecheck": {
      "command": "tsc --build --pretty --incremental",
      "clean": "if-file-deleted",
      "files": [
        "app/src/**/*",
        "packages/*/src/**/*",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [
        "packages/*/*.tsbuildinfo"
      ]
    }
  }
}
