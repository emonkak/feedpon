{
  "files": {
    "ignore": [".wireit", "dist", "node_modules", "package.json"]
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "a11y": {
        "all": false
      },
      "complexity": {
        "noBannedTypes": "off",
        "noThisInStatic": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedLabels": "off",
        "noEmptyPattern": "off",
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noUselessElse": "off",
        "useEnumInitializers": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noConfusingLabels": "off",
        "noConfusingVoidType": "off",
        "noEmptyInterface": "off",
        "noExplicitAny": "off"
      }
    }
  }
}
